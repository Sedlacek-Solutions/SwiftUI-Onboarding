          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte upozornění, abychom vás mohli informovat o důležitých aktualizacích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
