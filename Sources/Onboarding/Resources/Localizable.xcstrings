    "notifications.subtitle.default" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل التنبيهات لنتمكن من إعلامك بالتحديثات المهمة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
