    "feature.accessibility.content" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعم كامل للنص الديناميكي وميزات تسهيلات الاستخدام."
